{
  "name": "hokse-dse-study-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "dev:pilot": "node scripts/dev-pilot.mjs",
    "server": "node server/main.ts",
    "admin:init": "node server/bootstrap-admin.ts",
    "check:bootstrap": "node scripts/check-bootstrap.mjs",
    "check:postgres": "node scripts/check-postgres.mjs",
    "build:pilot": "node scripts/build-pilot.mjs",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "test:server": "node --test server/pilot.check.ts server/static.check.ts server/studio.check.ts",
    "extract:maths-index": "node scripts/extract-maths-metadata.mjs",
    "check:maths-index": "node scripts/check-maths-index.mjs",
    "backup:pilot": "node scripts/backup-pilot.mjs"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "msw": "^2.12.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/katex": "^0.16.7",
    "@types/node": "26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
