# Defaults: browser-local MSW mock, no API key required.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api/v1

# Real invited-pilot mode (start-pilot.cmd / pnpm dev:pilot sets this automatically):
# VITE_API_MODE=real
# Keep API same-origin. Configure model-provider URL/key in the developer UI, not VITE variables.
# HOKSE_DATABASE=.data/pilot.sqlite
# HOKSE_FRONTEND_PORT=5173
# PORT=3001
# HOST=127.0.0.1
# HOKSE_ORIGIN=http://127.0.0.1:5173
# Production behind HTTPS:
# HOKSE_STATIC_DIR=dist-pilot
# HOKSE_SECURE_COOKIE=true
# HOKSE_ALLOW_SETUP=false

# Free cloud deployment: backend secrets only, never VITE_*.
# Use a Supabase Session pooler URI (5432) with an encoded password.
# DATABASE_URL=postgresql://...
# HOKSE_ENCRYPTION_KEY=<32 random bytes encoded as Base64; keep stable across deploys>
# HOKSE_DATABASE_CA=<optional trusted database CA PEM; cloud TLS verification stays enabled>
# Keep actual cloud configuration in ignored .data/cloud.env.
